# Copy these values to node_backend/.env before starting the app.
PORT=3001
NODE_ENV=development
FLASK_BASE_URL=http://127.0.0.1:5000
FLASK_TIMEOUT_MS=120000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET_KEY=replace_with_a_long_random_secret
REFRESH_SECRET_KEY=replace_with_another_long_random_secret
APP_MAIL=your_email_address
APP_PASS=your_email_app_password
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret